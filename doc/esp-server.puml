@startuml
title ESP -> Server packet processing
actor ESPDevice
participant "ESPConnector" as ESPConnector
participant "DataService" as DataService
participant "PacketParser" as Parser
participant "PostgresRepo" as Repo
participant "Client" as Client

ESPDevice -> ESPConnector: send packet (text)
ESPConnector -> DataService: handleESPData(data)
DataService -> Parser: ParsePacketData(data) : models.Packet
alt parse success
DataService -> DataService: enqueue packet (non-blocking)
alt channel full
DataService -> Repo: Save(packet, sessionId) // fallback saving
DataService -> DataService: start DrainDataChannel() // drain in background
end
Note right: processPackets goroutine reads from packetChan
DataService -> Repo: Save(packet, sessionId)
DataService -> Client: SendPacketToClient(packet) // forward to client if present
else parse error
Parser --> DataService: error
end
@enduml