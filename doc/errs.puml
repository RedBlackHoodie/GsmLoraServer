@startuml title Error handling: DB, parsing, channel fallback, device write errors actor Main participant "PostgresRepo" as Repo participant "DataService" as DataService participant "PacketParser" as Parser participant "ESPConnector" as ESPConnector participant "processPackets goroutine" as Processor participant "DrainDataChannel goroutine" as Drain participant Logger

Main -> Repo: NewPostgresDB(config)
Repo -> Repo: Open & Ping (attempt 1..5)
alt ping success
Repo --> Main: db object
else ping fails after retries
Repo --> Main: error("failed to connect after 5 attempts")
Main -> Logger: log.Println("Error connecting to database")
Main -> Main: exit / return (app stops)
end

ESPConnector -> DataService: handleESPData(data)
DataService -> Parser: ParsePacketData
alt parse error
Parser --> DataService: error
DataService -> Logger: log.Printf("Unexpected error while parsing packet") stop
else parsed packet
DataService -> DataService: try enqueue packetChan
alt enqueue succeeds
Processor -> Repo: Save(packet, sessionId)
alt Save error
Repo --> Processor: error
Processor -> Logger: log.Printf("Error saving packet during processing")
end
else enqueue fails (channel full)
DataService -> Repo: Save(packet, sessionId) // immediate fallback
alt Save error
Repo --> DataService: error
DataService -> Logger: log.Printf("Unexpected error while saving data")
end
DataService -> Drain: start DrainDataChannel()
Drain -> Repo: Save(packet_from_channel)
alt Save error
Repo --> Drain: error
Drain -> Logger: log.Printf("Error saving packet during drain")
end
end
end

DataService -> ESPConnector: SendParamsToDevice(params)
alt ESPConnector not connected
ESPConnector -> DataService: log.Printf("not Connected to ESP32") ;
return error
DataService -> Logger: PendingMessages <- "ESP_NOT_CONNECTED"
else write attempt
ESPConnector -> ESPConnector: Conn.Write("SET_SETTINGS: ...")
alt write error
ESPConnector --> DataService: error
ESPConnector -> ESPConnector: e.isConnected = false
DataService -> Logger: log.Printf("Error sending params to device")
else write ok
ESPConnector --> DataService: ACK (implicit)
DataService -> Logger: log.Printf("Params sent to device successfully")
end
end
@enduml