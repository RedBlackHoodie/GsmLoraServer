@startuml title Start/Stop measurement and GET_MEASUREMENT actor Client participant "Server" as Server participant "Handler" as Handler participant "DataService" as DataService participant "ESPConnector" as ESPConnector participant "PostgresRepo" as Repo

Client -> Server: "START_MEASUREMENT" / "STOP_MEASUREMENT"
Server -> Handler: parse
Handler -> DataService: SendMeasurementCommand(conn, command, sessionId)
DataService -> DataService: PendingMessages <- {Destination:Lora, Message:command} ... processPendingMessages (goroutine) ...
DataService -> ESPConnector: SendMeasurementCommand(conn, command, sessionId)
ESPConnector -> ESPDevice: send command
ESPDevice -> ESPConnector: emits measurement packets -> (follow ESP packet processing sequence)

Client -> Server: "GET_MEASUREMENT[:id]"
Server -> Handler: parse
Handler -> DataService: GetMeasurements(requestID) alt requestID == 0
DataService -> Repo: FindLastRequestId() -> requestID end
DataService -> Repo: FindById(requestID)
Repo --> DataService: []Packet
DataService -> Server: SendMeasurementsToClient(conn, json)
Server -> Client: "MEASUREMENT: <json>"
@enduml