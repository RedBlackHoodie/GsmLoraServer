@startuml
title Client SET_SETTINGS flow
actor Client
participant "Server (net layer)" as Server
participant "MessageHandler" as Handler
participant "DataService" as DataService
participant "ESPConnector" as ESPConnector
participant "ClientConn" as ClientConn

Client -> Server: TCP: "SET_SETTINGS: SF=..., TX=..., BW=..."
Server -> Handler: parse -> SetSettingsMessage
Handler -> DataService: ProcessInterfaceSettingChange(conn, message)
DataService -> DataService: clients[conn] = Client
alt ESP connected
DataService -> DataService: interfaceSettingsChange <- params
DataService -> ESPConnector: SendParamsToDevice(params)
ESPConnector -> ESPDevice: write "SET_SETTINGS: ..."
ESPDevice --> ESPConnector: ACK / ERROR
ESPConnector --> DataService: ACK / ERROR
DataService -> ClientConn: send confirmation ("ESP_CONNECTED")
else ESP not connected
DataService -> DataService: PendingMessages <- {Destination: Client, "ESP_NOT_CONNECTED"}
DataService -> ClientConn: respond "ESP_NOT_CONNECTED"
end
@enduml